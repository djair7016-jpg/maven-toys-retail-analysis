      <column caption='Gross Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0847232319492097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross_Profit]) /&#13;&#10;SUM([Revenue])' />
      </column>
      <column caption='Units Sold Last 3M' datatype='integer' name='[Calculation_0847233088167938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] &gt;= #2023-07-01#&#13;&#10;AND [Date] &lt;= #2023-09-30#&#13;&#10;THEN [Units]&#13;&#10;END' />
      </column>
      <column caption='Avg Monthly Units' datatype='real' name='[Calculation_0847233088303107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0847233088167938]) / 3' />
